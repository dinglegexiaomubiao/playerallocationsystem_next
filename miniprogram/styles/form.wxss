/* 表单页共用样式（party-new / activity-new / food-review 用 @import 引入） */
.form {
  padding: 24rpx 24rpx 8rpx;
}

.field {
  margin-bottom: 24rpx;
}
.label {
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
  font-size: 25rpx;
  color: var(--text-2);
}
.req {
  color: var(--brand);
  margin-left: 4rpx;
}
.hint {
  margin-left: auto;
  font-size: 21rpx;
  color: var(--text-3);
}

/* ⚠ 小程序盒模型默认 content-box：只要给这些控件写了 width: 100%（或放进 flex
   且 flex-basis 满宽），padding 和 1px 边框就会额外加在 100% 之外，把页面顶出
   横向滚动条。textarea 早就写了 border-box，input / picker 补齐，保持一致 ——
   将来谁给它们加 width 都不会再踩一次。 */
.input {
  box-sizing: border-box;
  height: 80rpx;
  padding: 0 22rpx;
  background: var(--bg-page);
  border: var(--stroke) solid var(--border);
  border-radius: var(--radius);
  font-size: 27rpx;
  color: var(--text);
}
.ph {
  color: var(--text-3);
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  height: 160rpx;
  padding: 18rpx 22rpx;
  background: var(--bg-page);
  border: var(--stroke) solid var(--border);
  border-radius: var(--radius);
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--text);
}

/* picker 外观做成跟 input 一样（同样要 border-box） */
.picker {
  box-sizing: border-box;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 22rpx;
  background: var(--bg-page);
  border: var(--stroke) solid var(--border);
  border-radius: var(--radius);
  font-size: 27rpx;
  color: var(--text);
}
.picker.is-empty {
  color: var(--text-3);
}

.row2 {
  display: flex;
}
.row2 > .field {
  flex: 1;
}
.row2 > .field:first-child {
  margin-right: 16rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}
.chip {
  font-size: 24rpx;
  color: var(--text-2);
  background: var(--bg-card);
  border: var(--stroke) solid var(--border);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  margin: 0 12rpx 12rpx 0;
}
.chip.is-on {
  color: #ffffff;
  background: var(--brand);
  border-color: var(--brand);
}

.err {
  margin-bottom: 18rpx;
  padding: 16rpx 18rpx;
  background: rgba(176, 43, 37, 0.06);
  border: var(--stroke) solid var(--brand-border);
  border-radius: var(--radius);
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--brand-on-soft);
}

/* 按钮视觉属性统一在 app.wxss 的 .btn（表单页只引这份布局样式） */

.tip {
  margin-top: 20rpx;
  padding: 0 4rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-3);
}
.state {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-3);
}
