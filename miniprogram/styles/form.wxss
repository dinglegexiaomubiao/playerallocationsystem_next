/* 表单页共用样式（party-new / activity-new / food-review 用 @import 引入） */
.form {
  padding: 24rpx 24rpx 8rpx;
}

.field {
  margin-bottom: 24rpx;
}
.label {
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
  font-size: 25rpx;
  color: var(--text-2);
}
.req {
  color: var(--brand);
  margin-left: 4rpx;
}
.hint {
  margin-left: auto;
  font-size: 21rpx;
  color: var(--text-3);
}

.input {
  height: 80rpx;
  padding: 0 22rpx;
  background: var(--bg-page);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: 27rpx;
  color: var(--text);
}
.ph {
  color: var(--text-3);
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  height: 160rpx;
  padding: 18rpx 22rpx;
  background: var(--bg-page);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--text);
}

/* picker 外观做成跟 input 一样 */
.picker {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 22rpx;
  background: var(--bg-page);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: 27rpx;
  color: var(--text);
}
.picker.is-empty {
  color: var(--text-3);
}

.row2 {
  display: flex;
}
.row2 > .field {
  flex: 1;
}
.row2 > .field:first-child {
  margin-right: 16rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}
.chip {
  font-size: 24rpx;
  color: var(--text-2);
  background: var(--bg-card);
  border: 1px solid var(--border);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  margin: 0 12rpx 12rpx 0;
}
.chip.is-on {
  color: #ffffff;
  background: var(--brand);
  border-color: var(--brand);
}

.err {
  margin-bottom: 18rpx;
  padding: 16rpx 18rpx;
  background: rgba(176, 43, 37, 0.06);
  border: 1px solid var(--brand-border);
  border-radius: var(--radius);
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--brand-on-soft);
}

.btn {
  background: var(--brand);
  color: #ffffff;
  border-radius: var(--radius);
  font-size: 30rpx;
  font-weight: 500;
}
.btn::after {
  border: none;
}
.btn.is-busy {
  opacity: 0.7;
}

.tip {
  margin-top: 20rpx;
  padding: 0 4rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-3);
}
.state {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-3);
}
