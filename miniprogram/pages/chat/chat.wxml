<view class="page">
  <view class="topbar">
    <view class="topbar-hint">基于社区真实数据回答</view>
    <view class="topbar-clear" bindtap="onClear">清空</view>
  </view>

  <scroll-view class="messages" scroll-y scroll-into-view="{{scrollTo}}">
    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="msg {{item.role}}">
      <view class="bubble">{{item.content}}</view>
    </view>
    <view wx:if="{{loading}}" class="msg assistant">
      <view class="bubble">思考中…</view>
    </view>
  </scroll-view>

  <view class="composer">
    <input
      class="input"
      value="{{input}}"
      placeholder="问点什么，例如：阿吉最近战绩怎么样？"
      bindinput="onInput"
      bindconfirm="onSend"
      confirm-type="send"
    />
    <button class="send" size="mini" bindtap="onSend" loading="{{loading}}" disabled="{{loading}}">发送</button>
  </view>
</view>
