.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  background: var(--bg-card);
  border-bottom: 1px solid var(--border);
}
.topbar-hint {
  font-size: 22rpx;
  color: var(--text-3);
}
.topbar-clear {
  font-size: 26rpx;
  color: var(--brand);
}
.messages {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}
.msg {
  display: flex;
  margin-bottom: 24rpx;
}
.msg.user {
  justify-content: flex-end;
}
.bubble {
  max-width: 78%;
  padding: 18rpx 24rpx;
  border-radius: var(--radius-lg);
  line-height: 1.55;
  font-size: 28rpx;
  word-break: break-word;
}
.msg.assistant .bubble {
  background: var(--bg-card);
  border: 1px solid var(--border);
  color: var(--text);
}
.msg.user .bubble {
  background: var(--brand);
  color: #ffffff;
}
.composer {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1px solid var(--border);
}
.input {
  flex: 1;
  background: var(--bg-subtle);
  color: var(--text);
  border-radius: var(--radius);
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}
.send {
  margin-left: 16rpx;
  background: var(--brand);
  color: #ffffff;
  border-radius: var(--radius);
}
.send::after {
  border: none;
}
