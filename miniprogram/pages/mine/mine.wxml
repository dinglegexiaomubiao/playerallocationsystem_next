<view class="page-wrap">
  <block wx:if="{{logged}}">
    <view class="surface user">
      <view class="avatar">{{initial}}</view>
      <view class="user-body">
        <view class="line1">
          <text class="name">{{name}}</text>
          <text wx:if="{{isAdmin}}" class="tag">管理员</text>
        </view>
        <view class="muted">
          <text wx:if="{{loginAtText}}">登录于 {{loginAtText}}</text>
          <text wx:else>已登录</text>
        </view>
      </view>
    </view>

    <view class="muted note">登录态 30 天内有效，过期会自动清掉并提示重新登录。</view>

    <view class="surface link" bindtap="goProfile">
      <text class="link-text">个人信息</text>
      <text class="link-sub">分数 / 位置 / 地区 / 自我评价</text>
      <text class="link-arrow">›</text>
    </view>

    <view class="surface link" bindtap="goMyTournaments">
      <text class="link-text">我的赛事</text>
      <text class="link-sub">参加过的历届与我所在的队伍</text>
      <text class="link-arrow">›</text>
    </view>

    <view class="surface link" bindtap="goGuild">
      <text class="link-text">我的帮派</text>
      <text class="link-sub">创建 / 管理 / 邀请</text>
      <text class="link-arrow">›</text>
    </view>

    <view class="surface link" bindtap="goFeedback">
      <text class="link-text">意见反馈</text>
      <text class="link-sub">提建议 / 报问题，可查处理进度</text>
      <text class="link-arrow">›</text>
    </view>

    <view class="surface link" bindtap="goPassword">
      <text class="link-text">修改密码</text>
      <text class="link-sub">原密码 + 新密码，改完不用重新登录</text>
      <text class="link-arrow">›</text>
    </view>

    <button class="btn ghost" bindtap="logout">退出登录</button>
  </block>

  <block wx:else>
    <view class="surface guest">
      <view class="guest-title">还没登录</view>
      <view class="muted guest-desc">看内容不需要登录；发开黑、报名活动、给美食评分这些需要。</view>
      <button class="btn" bindtap="goLogin">去登录</button>
    </view>

    <view class="surface link" bindtap="goFeedback">
      <text class="link-text">意见反馈</text>
      <text class="link-sub">不登录也能提</text>
      <text class="link-arrow">›</text>
    </view>
  </block>

  <view class="section-title">开发者设置</view>
  <view class="surface dev">
    <view class="label">后端地址</view>
    <input class="input" value="{{base}}" bindinput="onBase" placeholder="https://..." />
    <view class="dev-tip">只在调试时改；正式环境用默认域名。</view>
    <button class="btn ghost small" bindtap="save">保存地址</button>
  </view>

  <view class="ver">版本 {{version}}</view>
</view>
