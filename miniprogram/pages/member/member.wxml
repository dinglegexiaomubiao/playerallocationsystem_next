<view class="page-wrap">
  <view wx:if="{{loading}}" class="center">加载中…</view>
  <view wx:elif="{{error}}" class="center">{{error}}</view>

  <block wx:else>
    <view class="surface hero">
      <image wx:if="{{p.avatar}}" class="avatar" src="{{p.avatar}}" mode="aspectFill"></image>
      <view wx:else class="avatar placeholder">{{p.initial}}</view>

      <view class="hero-body">
        <view class="name">{{p.nickname}}</view>
        <view wx:if="{{p.groupNickname}}" class="muted">群昵称 {{p.groupNickname}}</view>
        <view wx:if="{{p.regionText}}" class="muted">{{p.regionText}}</view>
        <view wx:if="{{p.guildName}}" class="guild">
          <text class="guild-dot"></text>
          <text>{{p.guildName}}</text>
          <text wx:if="{{p.guildSlogan}}" class="guild-slogan">「{{p.guildSlogan}}」</text>
        </view>
      </view>

      <view class="hero-score">
        <text class="score-num">{{p.score}}</text>
        <text class="score-label">分数</text>
      </view>
    </view>

    <view class="surface stats">
      <view class="cell">
        <text class="cell-num">{{p.winRate}}%</text>
        <text class="cell-label">胜率</text>
      </view>
      <view class="cell">
        <text class="cell-num">{{p.championships}}</text>
        <text class="cell-label">冠军</text>
      </view>
      <view class="cell">
        <text class="cell-num">{{p.runnerUp}}</text>
        <text class="cell-label">亚军</text>
      </view>
      <view class="cell">
        <text class="cell-num">{{p.recordCount}}</text>
        <text class="cell-label">参赛届</text>
      </view>
    </view>

    <view wx:if="{{p.positions.length}}" class="block">
      <view class="sec-title">位置</view>
      <view class="chips">
        <text wx:for="{{p.positions}}" wx:key="*this" class="chip">{{item}}</text>
      </view>
    </view>

    <view wx:if="{{p.heroesText}}" class="block">
      <view class="sec-title">擅长项</view>
      <view class="text">{{p.heroesText}}</view>
    </view>

    <view wx:if="{{p.selfIntro}}" class="block">
      <view class="sec-title">自述</view>
      <view class="surface quote">{{p.selfIntro}}</view>
    </view>

    <view wx:if="{{p.synergyText}}" class="block">
      <view class="sec-title">老搭档</view>
      <view class="text">{{p.synergyText}}</view>
    </view>

    <view wx:if="{{p.enemiesText}}" class="block">
      <view class="sec-title">苦主</view>
      <view class="text">{{p.enemiesText}}</view>
    </view>

    <view wx:if="{{p.records.length}}" class="block">
      <view class="sec-title">参赛记录</view>
      <view class="surface board">
        <view wx:for="{{p.records}}" wx:key="key" class="rec">
          <view class="rec-main">
            <text class="rec-tour">{{item.tournament}}</text>
            <text wx:if="{{item.rankText}}" class="rec-rank {{item.rank === 1 ? 'is-gold' : ''}}">{{item.rankText}}</text>
          </view>
          <view class="rec-sub">
            <text wx:if="{{item.team}}">{{item.team}}</text>
            <text wx:if="{{item.dateText}}" class="rec-date">{{item.dateText}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 近期战绩（OpenDota）：纯公开数据展示，下面「战绩解读」也吃这份数据。
         样本窗口与网页成员页「最近比赛」一致（最多 200 场），别改回 20 场。 -->
    <view class="block">
      <view class="sec-title">近期战绩<text class="sec-note">OpenDota</text></view>

      <view wx:if="{{!gameId}}" class="surface empty-tip">
        这位群友没填 SteamID，拉不到战绩，也没法做战绩解读。
      </view>

      <view wx:elif="{{stats.status === 'idle'}}" class="surface act-row">
        <text class="act-hint">数据从 OpenDota 实时拉，冷启动要几秒</text>
        <text class="act-btn" bindtap="onTapStats">拉取战绩</text>
      </view>

      <view wx:elif="{{stats.status === 'loading'}}" class="surface act-row">
        <text class="act-hint">正在拉取战绩…</text>
      </view>

      <view wx:elif="{{stats.status === 'error'}}" class="surface act-row">
        <text class="act-hint is-error">{{stats.error}}</text>
        <text class="act-btn" bindtap="onTapStats">重试</text>
      </view>

      <view wx:elif="{{stats.status === 'empty'}}" class="surface empty-tip">
        OpenDota 上没有这个账号的对局记录。常见原因：账号内未开启「公开比赛数据」，或 OpenDota 还没抓取过这个账号。
      </view>

      <view wx:else class="surface stats">
        <view class="cell">
          <text class="cell-num">{{stats.data.winRate}}%</text>
          <text class="cell-label">近 {{stats.data.total}} 场胜率</text>
        </view>
        <view class="cell">
          <text class="cell-num">{{stats.data.wins}} / {{stats.data.losses}}</text>
          <text class="cell-label">胜 / 负</text>
        </view>
        <view class="cell">
          <text class="cell-num">{{stats.data.kda}}</text>
          <text class="cell-label">场均 KDA</text>
        </view>
        <view class="cell">
          <text class="cell-num">{{stats.data.durationText}}</text>
          <text class="cell-label">平均时长</text>
        </view>

        <view class="stats-meta">
          <text wx:if="{{stats.data.accountLabel}}" class="stats-meta-i">{{stats.data.accountLabel}}</text>
          <text wx:if="{{stats.data.lifetimeText}}" class="stats-meta-i">生涯 {{stats.data.lifetimeText}}</text>
          <text class="stats-meta-i">近 20 场最高 {{stats.data.bestText}}</text>
        </view>

        <!-- GPM / 伤害只有近 20 场这个窗口有，单独一行标清口径，不和 200 场的胜率并排看 -->
        <view wx:if="{{stats.data.gpm || stats.data.dmg}}" class="stats-window">
          <text class="stats-window-t">近 {{stats.data.gpmTotal}} 场</text>
          <text wx:if="{{stats.data.gpm}}" class="stats-window-i">GPM {{stats.data.gpm}}</text>
          <text wx:if="{{stats.data.dmg}}" class="stats-window-i">场均伤害 {{stats.data.dmg}}</text>
        </view>

        <view wx:if="{{stats.data.heroes.length}}" class="stats-heroes">
          <text wx:for="{{stats.data.heroes}}" wx:key="name" class="stats-hero">{{item.name}} {{item.matches}} 场 · {{item.winRate}}%</text>
        </view>
      </view>
    </view>

    <!-- 战绩解读：数字全部来自上面那份公开战绩，按固定规则分档，不做推断也不做预测 -->
    <view class="block ai-block">
      <view class="sec-title">
        战绩解读
        <text wx:if="{{insight.status === 'done'}}" class="sec-note">{{insight.items}} 项</text>
      </view>

      <view wx:if="{{insight.status === 'idle'}}" class="surface act-row">
        <text class="act-hint">把近期战绩的数字按固定标准分档，不做预测</text>
        <text class="act-btn" bindtap="onTapInsight">{{gameId ? '看解读' : '无 SteamID'}}</text>
      </view>

      <view wx:elif="{{insight.status === 'running'}}" class="surface ai-loading">
        <view class="spinner"></view>
        <view class="ai-loading-body">
          <text class="ai-loading-title">{{stats.status === 'loading' ? '正在拉取战绩…' : '正在统计…'}}</text>
          <text class="ai-loading-hint">用公开战绩直接算，一般一秒内</text>
        </view>
      </view>

      <view wx:elif="{{insight.status === 'empty'}}" class="surface empty-tip">
        {{insight.emptyText}}
      </view>

      <block wx:else>
        <view class="surface ai-body">
          <view wx:for="{{insight.blocks}}" wx:key="k" class="ai-line {{item.type === 'item' ? 'is-item' : ''}}">
            <text wx:if="{{item.num}}" class="ai-num">{{item.num}}</text>
            <view class="ai-line-body">
              <text wx:for="{{item.segs}}" wx:for-item="seg" wx:key="k" class="ai-seg {{seg.b ? 'is-bold' : ''}}">{{seg.t}}</text>
            </view>
          </view>
          <view class="ai-foot">
            <text class="ai-foot-hint">{{insight.note}}</text>
            <text class="ai-rerun" bindtap="onTapInsight">重新统计</text>
          </view>
        </view>
      </block>
    </view>
  </block>
</view>
