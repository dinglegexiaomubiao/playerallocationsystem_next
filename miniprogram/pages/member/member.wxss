.hero {
  display: flex;
  padding: 26rpx;
  align-items: flex-start;
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  background: var(--bg-subtle);
  margin-right: 24rpx;
  flex: 0 0 auto;
}
.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--text-3);
}
.hero-body {
  flex: 1;
  min-width: 0;
}
.name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.3;
}
.guild {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-2);
}
.guild-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand);
  margin-right: 8rpx;
}
.guild-slogan {
  color: var(--text-3);
  margin-left: 6rpx;
}
.hero-score {
  flex: 0 0 auto;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.score-num {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--brand);
  line-height: 1.1;
}
.score-label {
  font-size: 20rpx;
  color: var(--text-3);
}

.stats {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding: 22rpx 0;
}
.cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cell-num {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}
.cell-label {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.block {
  margin-top: 28rpx;
}
.sec-title {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-3);
  letter-spacing: 1rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
}
.chip {
  font-size: 22rpx;
  color: var(--text-2);
  background: var(--bg-subtle);
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  margin: 0 10rpx 10rpx 0;
}
.text {
  font-size: 27rpx;
  line-height: 1.65;
  color: var(--text-2);
}
.quote {
  padding: 22rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text);
}

.board {
  padding: 0 22rpx;
}
.rec {
  padding: 18rpx 0;
  border-bottom: 1px solid var(--border);
}
.rec:last-child {
  border-bottom: none;
}
.rec-main {
  display: flex;
  align-items: center;
}
.rec-tour {
  font-size: 27rpx;
  color: var(--text);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rec-rank {
  flex: 0 0 auto;
  margin-left: 12rpx;
  font-size: 20rpx;
  color: var(--text-2);
  background: var(--bg-subtle);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.rec-rank.is-gold {
  color: var(--gold);
  background: var(--gold-soft);
}
.rec-sub {
  display: flex;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
.rec-date {
  margin-left: 12rpx;
}

/* ---------------- 近期战绩 / 战绩解读 ---------------- */
.sec-note {
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-3);
  letter-spacing: 0;
}

.act-row {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  margin-top: 16rpx;
}
.act-hint {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--text-3);
}
.act-hint.is-error {
  color: var(--brand);
}
.act-btn {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: var(--brand);
  border-radius: 999rpx;
}

.empty-tip {
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--text-3);
}

.stats-heroes {
  flex: 0 0 100%;
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding: 0 24rpx;
}
.stats-hero {
  font-size: 21rpx;
  color: var(--text-2);
  background: var(--bg-subtle);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin: 0 10rpx 10rpx 0;
}

.ai-loading {
  display: flex;
  align-items: center;
  padding: 30rpx 24rpx;
  margin-top: 16rpx;
}
.ai-loading-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.ai-loading-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}
.ai-loading-hint {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 转圈：纯 CSS，别为这个引图片 */
.spinner {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: ai-spin 0.9s linear infinite;
}
@keyframes ai-spin {
  to {
    transform: rotate(360deg);
  }
}

.ai-error {
  padding: 24rpx;
  margin-top: 16rpx;
}
.ai-error-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--brand);
}
.ai-error-acts {
  display: flex;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.ai-body {
  padding: 24rpx;
  margin-top: 16rpx;
}
.ai-line {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}
.ai-line:last-of-type {
  margin-bottom: 0;
}
.ai-line.is-item {
  margin-bottom: 20rpx;
}
.ai-num {
  flex: 0 0 auto;
  width: 34rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand);
  line-height: 1.75;
}
.ai-line-body {
  flex: 1;
  min-width: 0;
}
.ai-seg {
  font-size: 25rpx;
  line-height: 1.75;
  color: var(--text-2);
  word-break: break-word;
}
.ai-seg.is-bold {
  font-weight: 600;
  color: var(--text);
}

.ai-foot {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1px dashed var(--border);
}
.ai-foot-hint {
  flex: 1;
  font-size: 21rpx;
  color: var(--text-3);
}
.ai-rerun {
  font-size: 22rpx;
  color: var(--brand);
  padding: 4rpx 14rpx;
  border: 1px solid var(--brand-border);
  border-radius: 6rpx;
}
