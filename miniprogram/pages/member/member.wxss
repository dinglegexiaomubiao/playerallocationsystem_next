.hero {
  display: flex;
  padding: 26rpx;
  align-items: flex-start;
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  background: var(--bg-subtle);
  margin-right: 24rpx;
  flex: 0 0 auto;
}
.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--text-3);
}
.hero-body {
  flex: 1;
  min-width: 0;
}
.name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.3;
}
.guild {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-2);
}
.guild-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand);
  margin-right: 8rpx;
}
.guild-slogan {
  color: var(--text-3);
  margin-left: 6rpx;
}
.hero-score {
  flex: 0 0 auto;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.score-num {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--brand);
  line-height: 1.1;
}
.score-label {
  font-size: 20rpx;
  color: var(--text-3);
}

.stats {
  display: flex;
  margin-top: 16rpx;
  padding: 22rpx 0;
}
.cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cell-num {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}
.cell-label {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.block {
  margin-top: 28rpx;
}
.sec-title {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-3);
  letter-spacing: 1rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
}
.chip {
  font-size: 22rpx;
  color: var(--text-2);
  background: var(--bg-subtle);
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  margin: 0 10rpx 10rpx 0;
}
.text {
  font-size: 27rpx;
  line-height: 1.65;
  color: var(--text-2);
}
.quote {
  padding: 22rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text);
}

.board {
  padding: 0 22rpx;
}
.rec {
  padding: 18rpx 0;
  border-bottom: 1px solid var(--border);
}
.rec:last-child {
  border-bottom: none;
}
.rec-main {
  display: flex;
  align-items: center;
}
.rec-tour {
  font-size: 27rpx;
  color: var(--text);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rec-rank {
  flex: 0 0 auto;
  margin-left: 12rpx;
  font-size: 20rpx;
  color: var(--text-2);
  background: var(--bg-subtle);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.rec-rank.is-gold {
  color: var(--gold);
  background: var(--gold-soft);
}
.rec-sub {
  display: flex;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
.rec-date {
  margin-left: 12rpx;
}
