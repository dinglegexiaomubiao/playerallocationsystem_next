.bar {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.row {
  display: flex;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: var(--bg-subtle);
  margin-right: 20rpx;
  flex: 0 0 auto;
}
.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
  font-size: 34rpx;
}
.body {
  flex: 1;
  min-width: 0;
}
.line1 {
  display: flex;
  align-items: center;
}
.name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
  margin-right: 12rpx;
}
.tag {
  font-size: 20rpx;
  color: var(--brand-on-soft);
  background: rgba(176, 43, 37, 0.08);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}
.score {
  margin-left: auto;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
}
.tags {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
}
.chip {
  font-size: 20rpx;
  color: var(--text-2);
  background: var(--bg-subtle);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin: 4rpx 8rpx 0 0;
}
