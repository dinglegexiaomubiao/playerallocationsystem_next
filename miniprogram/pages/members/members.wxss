@import "../../styles/form.wxss";

.bar {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.row {
  display: flex;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-subtle);
  margin-right: 20rpx;
  flex: 0 0 auto;
}
.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
  font-size: 34rpx;
}
.body {
  flex: 1;
  min-width: 0;
}
.line1 {
  display: flex;
  align-items: center;
}
.name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
  margin-right: 12rpx;
}
.tag {
  font-size: 20rpx;
  color: var(--brand-on-soft);
  background: rgba(176, 43, 37, 0.08);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  margin-right: 12rpx;
}
.score {
  margin-left: auto;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
}
.tags {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
}
.chip {
  font-size: 20rpx;
  color: var(--text-2);
  background: var(--bg-subtle);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  margin: 4rpx 8rpx 0 0;
}

/* ---- 搜索与筛选 ---- */
.search {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.search .input {
  flex: 1;
  min-width: 0;
  padding-right: 60rpx;
}
.clear {
  position: absolute;
  right: 156rpx;
  padding: 0 16rpx;
  font-size: 32rpx;
  color: var(--text-3);
}
.filter-btn {
  flex: 0 0 auto;
  margin-left: 14rpx;
  padding: 0 22rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 25rpx;
  color: var(--text-2);
  background: var(--bg-card);
  border: var(--stroke) solid var(--border);
  border-radius: var(--radius);
}
.filter-btn.on {
  color: #ffffff;
  background: var(--brand);
  border-color: var(--brand);
}

.quick {
  display: flex;
  margin-bottom: 14rpx;
}
.quick picker {
  flex: 1;
  min-width: 0;
}
.quick picker + picker {
  margin-left: 12rpx;
}
.quick-item {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 16rpx;
  font-size: 23rpx;
  color: var(--text-2);
  background: var(--bg-card);
  border: var(--stroke) solid var(--border);
  border-radius: var(--radius);
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.panel {
  padding: 24rpx 24rpx 8rpx;
  margin-bottom: 14rpx;
}
.panel .field {
  margin-bottom: 20rpx;
}
.picker-value {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--text);
  background: var(--bg-page);
  border: var(--stroke) solid var(--border);
  border-radius: var(--radius);
}
.chips {
  display: flex;
  flex-wrap: wrap;
}
.chips .chip {
  padding: 8rpx 22rpx;
  font-size: 24rpx;
  border: var(--stroke) solid var(--border);
  border-radius: var(--radius-pill);
  background: var(--bg-page);
}
.chips .chip.on {
  color: #ffffff;
  background: var(--brand);
  border-color: var(--brand);
}
/* 擅长项上百种，装进固定高度的滚动区，不然面板本身会被撑到一两屏 */
.chips-scroll {
  max-height: 320rpx;
}
.chip-n {
  font-size: 18rpx;
  opacity: 0.55;
}
.label-note {
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--brand);
}
.panel-foot {
  padding: 4rpx 0 16rpx;
  text-align: right;
}
.reset {
  font-size: 24rpx;
  color: var(--brand);
}
.small {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--brand);
}
