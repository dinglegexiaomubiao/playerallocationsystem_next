.bar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.bar-text {
  flex: 1;
}
/* 有帮派时说「我的帮派」，没有时引导去创建 —— 文案在 js 里算，模板不做判断 */
.bar-btn {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: var(--brand);
  background: var(--bg-card);
  border: 1px solid var(--brand-border);
  border-radius: 999rpx;
  flex: 0 0 auto;
}
.card {
  display: flex;
  overflow: hidden;
  padding: 0;
  margin-bottom: 16rpx;
}
.stripe {
  width: 10rpx;
  flex: 0 0 auto;
}
.body {
  flex: 1;
  min-width: 0;
  padding: 22rpx;
}
.line1 {
  display: flex;
  align-items: center;
}
.name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
  margin-right: 12rpx;
}
.tag.is-mine {
  font-size: 20rpx;
  color: var(--gold);
  background: var(--gold-soft);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}
.count {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text-3);
  flex: 0 0 auto;
}
.slogan {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.heads {
  display: flex;
  margin-top: 14rpx;
}
.head {
  width: 52rpx;
  height: 52rpx;
  border-radius: 10rpx;
  background: var(--bg-subtle);
  margin-right: 10rpx;
  flex: 0 0 auto;
}
.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-3);
}

/* ---------- 他人帮派详情弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  display: flex;
  overflow: hidden;
  background: var(--bg-card);
  border-radius: 20rpx 20rpx 0 0;
  /* 底部安全区：全面屏手机不给这行，弹层按钮会被小白条压住 */
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.sheet-stripe {
  width: 10rpx;
  flex: 0 0 auto;
}
.sheet-body {
  flex: 1;
  min-width: 0;
  padding: 28rpx 26rpx 8rpx;
}
.sheet-line1 {
  display: flex;
  align-items: center;
}
.sheet-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  margin-right: 12rpx;
}
.sheet-slogan {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
}
.kv {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 26rpx;
}
.k {
  width: 88rpx;
  flex: 0 0 auto;
  color: var(--text-3);
}
.v {
  color: var(--text);
}
.link {
  color: var(--brand);
}
.sheet-heads {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.head-cell {
  width: 116rpx;
  margin-right: 8rpx;
  margin-bottom: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.head-cell .head {
  margin-right: 0;
}
.head-name {
  margin-top: 6rpx;
  max-width: 116rpx;
  font-size: 20rpx;
  color: var(--text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: center;
}
.hint {
  margin-top: 10rpx;
  padding: 16rpx 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-2);
  background: var(--bg-subtle);
  border-radius: 12rpx;
}
.sheet-actions {
  display: flex;
  margin-top: 22rpx;
}
.btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: var(--brand);
  border-radius: 12rpx;
}
.btn.ghost {
  margin-right: 16rpx;
  color: var(--text-2);
  background: var(--bg-subtle);
}
