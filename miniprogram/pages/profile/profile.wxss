@import "../../styles/form.wxss";

/* 个人信息：字段多但同质，靠分组卡片（基本资料 / 关系标注）分段 */
.page-wrap {
  padding-bottom: 24rpx;
}

.head {
  padding: 16rpx 24rpx;
  margin-bottom: 8rpx;
}
/* 昵称和帮派名都是用户自己填的，可能是很长的英文/数字串；这一行是 flex 且不换行，
   不设省略号就会把整行顶出屏幕（实测超长昵称能让页面右滑）。 */
.line1 {
  display: flex;
  align-items: baseline;
  margin-bottom: 6rpx;
}
.nick {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.guild {
  flex: 0 0 auto;
  max-width: 45%;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 21rpx;
  color: var(--text-3);
  background: var(--bg-subtle);
  border-radius: var(--radius-pill);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.small {
  margin-top: 4rpx;
  font-size: 21rpx;
}

/* 区块标题、卡片内边距都用全局的 .sec-title / .card（app.wxss），
   这里只补本页特有的东西：表单字段多，卡片底部留白比其他页紧一点 */
.card {
  padding: 24rpx 24rpx 8rpx;
}

/* 位置多选 */
.chips {
  display: flex;
  flex-wrap: wrap;
}
.chip {
  margin: 0 14rpx 14rpx 0;
  padding: 8rpx 22rpx;
  font-size: 25rpx;
  color: var(--text-2);
  background: var(--bg-page);
  border: var(--stroke) solid var(--border);
  border-radius: var(--radius-pill);
}
.chip.on {
  color: #ffffff;
  background: var(--brand);
  border-color: var(--brand);
}

.tip {
  margin: 18rpx 4rpx 0;
  font-size: 21rpx;
  color: var(--text-3);
}

.bar-space {
  height: 120rpx;
}
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: var(--stroke) solid var(--border);
}
.bar-info {
  flex: 1;
  min-width: 0;
}
/* 底栏保存按钮：视觉属性见 app.wxss 的 .btn，这里只管「别被压扁」 */
.btn {
  flex: 0 0 auto;
  min-width: 180rpx;
}

.link-btn {
  margin-top: 20rpx;
  padding: 0 40rpx;
  display: inline-block;
}
