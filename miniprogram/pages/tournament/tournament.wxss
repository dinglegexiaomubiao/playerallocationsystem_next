/* 赛事详情：信息密度比列表页高，靠间距和字号分层，不靠边框堆叠 */
.page-wrap {
  padding-bottom: 24rpx;
}

.head {
  padding: 24rpx;
}
.head-line {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.name {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}
.chip {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  font-size: 21rpx;
  color: var(--brand-on-soft);
  background: var(--gold-soft);
  border: 1px solid var(--brand-border);
  border-radius: 999rpx;
}
.prize {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--gold);
}

.sec-title {
  margin: 28rpx 0 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-3);
  letter-spacing: 1rpx;
}
.count {
  margin-left: 10rpx;
  font-weight: 400;
}

/* ---- 名次 ---- */
.place {
  display: flex;
  align-items: baseline;
  padding: 18rpx 24rpx;
  border-bottom: 1px solid var(--border);
}
.place:last-child {
  border-bottom: 0;
}
.place-label {
  flex: 0 0 auto;
  width: 96rpx;
  font-size: 23rpx;
  color: var(--gold);
}
.place-team {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  color: var(--text);
}
.place-note {
  flex: 0 0 auto;
  margin-left: 12rpx;
  font-size: 21rpx;
  color: var(--text-3);
}

/* ---- 赛程 ---- */
.round {
  margin-bottom: 16rpx;
}
.round-name {
  margin: 0 0 8rpx 4rpx;
  font-size: 23rpx;
  color: var(--text-2);
}
.match {
  padding: 18rpx 24rpx;
}
.match-row {
  display: flex;
  align-items: center;
}
.team-a {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 27rpx;
  color: var(--text-2);
  word-break: break-all;
}
.team-b {
  flex: 1;
  min-width: 0;
  text-align: left;
  font-size: 27rpx;
  color: var(--text-2);
  word-break: break-all;
}
.win {
  color: var(--brand);
  font-weight: 600;
}
.score {
  flex: 0 0 auto;
  width: 130rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text);
}
.score.dim {
  color: var(--text-3);
  font-weight: 400;
}
.match-meta {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}
.grudge {
  margin-left: 12rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  color: var(--brand);
  border: 1px solid var(--brand-border);
  border-radius: 6rpx;
}

/* ---- 队伍 ---- */
.team {
  padding: 20rpx 24rpx;
  margin-bottom: 14rpx;
}
.team-head {
  display: flex;
  align-items: center;
}
.team-name {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
}
.rank {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  color: var(--gold);
  background: var(--gold-soft);
  border-radius: 6rpx;
}
.team-n {
  flex: 0 0 auto;
  margin-left: 12rpx;
}
.toggle {
  flex: 0 0 auto;
  margin-left: 14rpx;
  font-size: 23rpx;
  color: var(--brand);
}
.members {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1px dashed var(--border);
}
.member {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  font-size: 25rpx;
}
.mem-name {
  flex: 0 1 auto;
  color: var(--text-2);
}
.mem-group {
  margin-left: 10rpx;
  font-size: 21rpx;
  color: var(--text-3);
}
.mem-pos {
  margin-left: auto;
  font-size: 21rpx;
  color: var(--text-3);
}

/* ---- 报名名单 ---- */
.signup {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1px solid var(--border);
}
.signup:last-of-type {
  border-bottom: 0;
}
.signup-line {
  display: flex;
  align-items: baseline;
}
.signup-name {
  flex: 0 1 auto;
  font-size: 27rpx;
  color: var(--text);
}
.signup-group {
  margin-left: 10rpx;
  font-size: 21rpx;
  color: var(--text-3);
}
.signup-cap {
  margin-left: 10rpx;
  padding: 0 8rpx;
  font-size: 19rpx;
  color: var(--brand);
  border: 1px solid var(--brand-border);
  border-radius: 4rpx;
}
.signup-score {
  margin-left: auto;
  font-size: 23rpx;
  color: var(--text-3);
}
.more {
  padding: 20rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--brand);
  border-top: 1px solid var(--border);
}
.center {
  padding: 40rpx 0;
}

/* ---- 底部操作条 ---- */
.bar-space {
  height: 120rpx;
}
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1px solid var(--border);
}
.bar-info {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
}
.ok {
  color: var(--brand-on-soft);
}
.warn {
  color: #8a5a00;
}
.btn {
  flex: 0 0 auto;
  margin: 0;
  min-width: 180rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 34rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: var(--brand);
  border-radius: var(--radius);
}
.btn::after {
  border: 0;
}
.btn.ghost {
  color: var(--text-2);
  background: var(--bg-page);
  border: 1px solid var(--border);
}

/* ───────── 以下为本次补齐赛事页新增结构（Tab / 概览定义表 / 赛程阵容 / 队伍头像 / 报名头像） ───────── */

/* ---- 顶部四 Tab（对齐网页端四个分区） ---- */
.tabs {
  display: flex;
  margin: 18rpx 0 4rpx;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: var(--text-2);
  border-right: 1px solid var(--border);
}
.tab:last-child {
  border-right: 0;
}
.tab.is-on {
  color: #ffffff;
  background: var(--brand);
  font-weight: 600;
}
.tab-n {
  display: inline-block;
  min-width: 30rpx;
  margin-left: 6rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  background: var(--bg-subtle);
  color: var(--text-3);
  border-radius: 999rpx;
}
.tab.is-on .tab-n {
  background: rgba(255, 255, 255, 0.28);
  color: #ffffff;
}

/* ---- 概览：赛事信息定义表 ---- */
.deflist {
  padding: 8rpx 24rpx;
}
.def {
  display: flex;
  align-items: baseline;
  padding: 14rpx 0;
  border-bottom: 1px solid var(--border);
}
.def:last-child {
  border-bottom: 0;
}
.def-k {
  flex: 0 0 168rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.def-v {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text);
}
.gold {
  color: var(--gold);
}

/* ---- 概览：赛果摘要行 ---- */
.sec-sub {
  margin-left: 10rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: var(--text-3);
}
.brief {
  display: flex;
  align-items: baseline;
  padding: 14rpx 24rpx;
  border-bottom: 1px solid var(--border);
}
.brief:last-child {
  border-bottom: 0;
}
.brief-a,
.brief-b {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-2);
}
.brief-a {
  text-align: right;
}
.brief-b {
  text-align: left;
}
.brief-s {
  flex: 0 0 auto;
  width: 120rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}
.brief-a.win,
.brief-b.win {
  color: var(--brand);
  font-weight: 600;
}
.dim {
  color: var(--text-3);
}

/* ---- 赛程：轮次名 + 单局头 ---- */
.round-name {
  display: flex;
  align-items: baseline;
}
.round-n {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: var(--text-3);
}
.match-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 4rpx;
}
.match-round {
  font-size: 22rpx;
  color: var(--text-3);
}
.match-time {
  font-size: 21rpx;
  color: var(--text-3);
}
.tag {
  padding: 0 10rpx;
  font-size: 20rpx;
  color: var(--text-2);
  background: var(--bg-subtle);
  border-radius: 6rpx;
}
.mid {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: var(--brand);
  border: 1px solid var(--brand-border);
  border-radius: 6rpx;
  padding: 0 8rpx;
}
.match-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--bg-subtle);
  border-radius: 6rpx;
  padding: 8rpx 12rpx;
}

/* ---- 赛程：展开后的阵容（两队上下堆叠，对齐网页 MatchCard） ---- */
.side {
  margin-top: 12rpx;
}
.side-bar {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  padding: 8rpx 12rpx;
  border-radius: 6rpx;
  background: var(--bg-subtle);
  font-size: 22rpx;
  color: var(--text-2);
}
.side-bar.radiant {
  border-left: 6rpx solid var(--ok);
}
.side-bar.dire {
  border-left: 6rpx solid var(--danger);
}
.side-bar.is-lose {
  opacity: 0.72;
}
.side-tag {
  font-weight: 600;
  margin-right: 8rpx;
}
.side-tag.radiant {
  color: var(--ok);
}
.side-tag.dire {
  color: var(--danger);
}
.side-name {
  font-weight: 600;
  color: var(--text);
  margin-right: 10rpx;
}
.side-win {
  color: var(--ok);
  margin-right: 8rpx;
}
.side-standin {
  color: var(--gold);
  margin-right: 8rpx;
}
.side-stats {
  color: var(--text-3);
}
.side-nodata {
  color: var(--text-3);
}
.prow {
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx 8rpx 18rpx;
}
.p-hero {
  width: 58rpx;
  height: 58rpx;
  border-radius: 8rpx;
  flex: 0 0 auto;
  background: var(--bg-subtle);
  margin-right: 12rpx;
}
.p-hero-txt {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: var(--text-3);
  text-align: center;
  line-height: 1.1;
  padding: 2rpx;
}
.p-main {
  flex: 1;
  min-width: 0;
}
.p-line {
  display: flex;
  align-items: baseline;
}
.p-name {
  font-size: 26rpx;
  color: var(--text);
  margin-right: 8rpx;
}
.p-flag {
  font-size: 18rpx;
  color: var(--gold);
  border: 1px solid var(--gold-soft);
  border-radius: 4rpx;
  padding: 0 6rpx;
  margin-right: 8rpx;
}
.p-kda {
  margin-left: auto;
  font-size: 23rpx;
  color: var(--text-2);
}
.p-line2 {
  display: flex;
  align-items: center;
  margin-top: 2rpx;
  flex-wrap: wrap;
}
.p-num {
  font-size: 20rpx;
  color: var(--text-3);
  margin-right: 12rpx;
}
.p-badge {
  font-size: 18rpx;
  color: var(--brand-on-soft);
  background: var(--brand-border);
  border-radius: 4rpx;
  padding: 0 6rpx;
  margin-right: 8rpx;
}
.p-items {
  display: flex;
  margin-left: auto;
}
.p-item {
  width: 30rpx;
  height: 30rpx;
  border-radius: 4rpx;
  margin-left: 4rpx;
  background: var(--bg-subtle);
}

/* ---- 队伍：meta / 头像 / 交战记录 ---- */
.team-meta {
  display: flex;
  flex-wrap: wrap;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-3);
}
.team-meta text {
  margin-right: 16rpx;
}
.mem-ava {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  flex: 0 0 auto;
  margin-right: 14rpx;
  background: var(--bg-subtle);
}
.mem-ava-txt {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-3);
}
.mem-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.mem-line {
  display: flex;
  align-items: baseline;
}
.mem-cap {
  margin-left: 8rpx;
  font-size: 18rpx;
  color: var(--gold);
  border: 1px solid var(--gold-soft);
  border-radius: 4rpx;
  padding: 0 6rpx;
}
.mem-score {
  flex: 0 0 auto;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-3);
  font-weight: 600;
}
.vs {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1px dashed var(--border);
  font-size: 21rpx;
  color: var(--text-3);
}
.vs-t {
  margin-right: 12rpx;
  color: var(--text-2);
}
.vs-i {
  margin-right: 14rpx;
}
.vs-w {
  color: var(--ok);
  margin-left: 2rpx;
}
.vs-l {
  color: var(--danger);
  margin-left: 2rpx;
}
.vs-p {
  color: var(--text-3);
  margin-left: 2rpx;
}

/* ---- 报名名单：头像 ---- */
.signup-ava {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  flex: 0 0 auto;
  margin-right: 16rpx;
  background: var(--bg-subtle);
}
.signup-ava-txt {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-3);
}
.signup-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.signup-team {
  margin-left: 10rpx;
  font-size: 21rpx;
  color: var(--brand);
}
.signup-team.is-none {
  color: var(--text-3);
}
.signup-sub {
  display: flex;
  align-items: baseline;
  margin-top: 2rpx;
  font-size: 21rpx;
  color: var(--text-3);
}
.signup-time {
  margin-left: auto;
}

/* ---- 底部已结束锁定条 ---- */
.bar-locked {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  color: var(--text-3);
}
