/* 赛事详情：信息密度比列表页高，靠间距和字号分层，不靠边框堆叠 */
.page-wrap {
  padding-bottom: 24rpx;
}

.head {
  padding: 24rpx;
}
.head-line {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.name {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}
.chip {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  font-size: 21rpx;
  color: var(--brand-on-soft);
  background: var(--gold-soft);
  border: 1px solid var(--brand-border);
  border-radius: 999rpx;
}
.prize {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--gold);
}

.sec-title {
  margin: 28rpx 0 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-3);
  letter-spacing: 1rpx;
}
.count {
  margin-left: 10rpx;
  font-weight: 400;
}

/* ---- 名次 ---- */
.place {
  display: flex;
  align-items: baseline;
  padding: 18rpx 24rpx;
  border-bottom: 1px solid var(--border);
}
.place:last-child {
  border-bottom: 0;
}
.place-label {
  flex: 0 0 auto;
  width: 96rpx;
  font-size: 23rpx;
  color: var(--gold);
}
.place-team {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  color: var(--text);
}
.place-note {
  flex: 0 0 auto;
  margin-left: 12rpx;
  font-size: 21rpx;
  color: var(--text-3);
}

/* ---- 赛程 ---- */
.round {
  margin-bottom: 16rpx;
}
.round-name {
  margin: 0 0 8rpx 4rpx;
  font-size: 23rpx;
  color: var(--text-2);
}
.match {
  padding: 18rpx 24rpx;
  border-bottom: 1px solid var(--border);
}
.match:last-child {
  border-bottom: 0;
}
.match-row {
  display: flex;
  align-items: center;
}
.team-a {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 27rpx;
  color: var(--text-2);
  word-break: break-all;
}
.team-b {
  flex: 1;
  min-width: 0;
  text-align: left;
  font-size: 27rpx;
  color: var(--text-2);
  word-break: break-all;
}
.win {
  color: var(--brand);
  font-weight: 600;
}
.score {
  flex: 0 0 auto;
  width: 130rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text);
}
.score.dim {
  color: var(--text-3);
  font-weight: 400;
}
.match-meta {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}
.grudge {
  margin-left: 12rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  color: var(--brand);
  border: 1px solid var(--brand-border);
  border-radius: 6rpx;
}

/* ---- 队伍 ---- */
.team {
  padding: 20rpx 24rpx;
  margin-bottom: 14rpx;
}
.team-head {
  display: flex;
  align-items: center;
}
.team-name {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
}
.rank {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  color: var(--gold);
  background: var(--gold-soft);
  border-radius: 6rpx;
}
.team-n {
  flex: 0 0 auto;
  margin-left: 12rpx;
}
.toggle {
  flex: 0 0 auto;
  margin-left: 14rpx;
  font-size: 23rpx;
  color: var(--brand);
}
.members {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1px dashed var(--border);
}
.member {
  display: flex;
  align-items: baseline;
  padding: 6rpx 0;
  font-size: 25rpx;
}
.mem-name {
  flex: 0 1 auto;
  color: var(--text-2);
}
.mem-group {
  margin-left: 10rpx;
  font-size: 21rpx;
  color: var(--text-3);
}
.mem-pos {
  margin-left: auto;
  font-size: 21rpx;
  color: var(--text-3);
}

/* ---- 报名名单 ---- */
.signup {
  padding: 16rpx 24rpx;
  border-bottom: 1px solid var(--border);
}
.signup:last-of-type {
  border-bottom: 0;
}
.signup-line {
  display: flex;
  align-items: baseline;
}
.signup-name {
  flex: 0 1 auto;
  font-size: 27rpx;
  color: var(--text);
}
.signup-group {
  margin-left: 10rpx;
  font-size: 21rpx;
  color: var(--text-3);
}
.signup-cap {
  margin-left: 10rpx;
  padding: 0 8rpx;
  font-size: 19rpx;
  color: var(--brand);
  border: 1px solid var(--brand-border);
  border-radius: 4rpx;
}
.signup-score {
  margin-left: auto;
  font-size: 23rpx;
  color: var(--text-3);
}
.more {
  padding: 20rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--brand);
  border-top: 1px solid var(--border);
}
.center {
  padding: 40rpx 0;
}

/* ---- 底部操作条 ---- */
.bar-space {
  height: 120rpx;
}
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1px solid var(--border);
}
.bar-info {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
}
.ok {
  color: var(--brand-on-soft);
}
.warn {
  color: #8a5a00;
}
.btn {
  flex: 0 0 auto;
  margin: 0;
  min-width: 180rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 34rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: var(--brand);
  border-radius: var(--radius);
}
.btn::after {
  border: 0;
}
.btn.ghost {
  color: var(--text-2);
  background: var(--bg-page);
  border: 1px solid var(--border);
}
