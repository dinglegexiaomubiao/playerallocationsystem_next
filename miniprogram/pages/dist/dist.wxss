.overview {
  padding: 24rpx;
}
.ov-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}
.ov-grid {
  display: flex;
  margin-top: 18rpx;
}
.ov-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.ov-num {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--brand);
  line-height: 1.2;
}
.ov-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}


.board {
  padding: 8rpx 24rpx;
}
.bar-row {
  padding: 16rpx 0;
  border-bottom: var(--stroke) solid var(--border);
}
.bar-row:last-child {
  border-bottom: none;
}
.bar-head {
  display: flex;
  align-items: baseline;
}
.bar-name {
  font-size: 28rpx;
  color: var(--text);
  flex: 1;
  min-width: 0;
}
.bar-name.is-mine {
  color: var(--brand);
  font-weight: 500;
}
.bar-num {
  font-size: 24rpx;
  color: var(--text-2);
  flex: 0 0 auto;
}
.bar-track {
  margin-top: 10rpx;
  height: 12rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-subtle);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: var(--radius-pill);
}
/* 三档色阶：人越多越接近品牌红，别用透明度（浅底上看不出差别） */
.bar-fill.lv1 {
  background: rgba(176, 43, 37, 0.25);
}
.bar-fill.lv2 {
  background: rgba(176, 43, 37, 0.55);
}
.bar-fill.lv3 {
  background: var(--brand);
}
.bar-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.foot {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
}

/* ---- 面包屑（下钻） ---- */
.crumbs {
  white-space: nowrap;
  margin-bottom: 14rpx;
}
.crumbs-inner {
  display: flex;
  align-items: center;
}
.crumb {
  font-size: 24rpx;
  color: var(--brand);
  padding: 6rpx 4rpx;
}
.crumb.is-now {
  color: var(--text);
  font-weight: 600;
}
.crumb-sep {
  margin: 0 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.notice {
  margin-bottom: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--text-2);
  background: var(--bg-subtle);
  border-radius: var(--radius);
}

.ov-hint {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: var(--stroke) dashed var(--border);
  font-size: 21rpx;
  color: var(--text-3);
}

.section-note {
  margin-left: 8rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-3);
  letter-spacing: 0;
}

/* ---- 区划行内的可点线索 ---- */
.mine-tag {
  flex: 0 0 auto;
  margin-right: 10rpx;
  padding: 0 8rpx;
  font-size: 18rpx;
  color: var(--brand);
  border: var(--stroke) solid var(--brand-border);
  border-radius: var(--radius-xs);
}
.drill-tag {
  flex: 0 0 auto;
  margin-right: 8rpx;
  font-size: 26rpx;
  color: var(--text-3);
}
.bar-num.is-tappable {
  color: var(--brand);
  text-decoration: underline;
  text-decoration-style: dotted;
}

/* ---- 名单 ---- */
.area-people {
  padding: 2rpx 0 8rpx 12rpx;
  border-bottom: var(--stroke) solid var(--border);
}
.people-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.people-initial {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  margin-right: 14rpx;
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--bg-subtle);
  border-radius: var(--radius-xs);
}
.people-name {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: var(--text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.people-arrow {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: var(--text-3);
}
.more-row {
  padding: 16rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: var(--brand);
}
