.wrap {
  padding: 24rpx 28rpx 48rpx;
}

.hero {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.02em;
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.cta {
  background: rgba(176, 43, 37, 0.05);
  border: 1px solid var(--brand-border);
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}
.cta-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand-on-soft);
}
.cta-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-2);
}
.cta-btn {
  display: inline-block;
  margin-top: 18rpx;
  padding: 14rpx 32rpx;
  background: var(--brand);
  color: #ffffff;
  border-radius: var(--radius);
  font-size: 26rpx;
  font-weight: 500;
}

.ticker {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}
.ticker-label {
  flex: 0 0 auto;
  font-size: 20rpx;
  color: var(--brand-on-soft);
  background: rgba(176, 43, 37, 0.08);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
}
.ticker-swiper {
  flex: 1;
  min-width: 0;
  height: 76rpx;
}
.ticker-item {
  height: 76rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.ticker-text {
  font-size: 25rpx;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ticker-from {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.card {
  width: 48.5%;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}
.card-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
}
.card-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.foot {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
}
