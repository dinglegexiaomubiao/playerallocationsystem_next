.card {
  padding: 24rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
}
.sub {
  margin-top: 6rpx;
  margin-bottom: 28rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.field {
  margin-bottom: 22rpx;
}
.label {
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: var(--text-2);
}
.input {
  height: 80rpx;
  padding: 0 22rpx;
  background: var(--bg-page);
  border: var(--stroke) solid var(--border);
  border-radius: var(--radius);
  font-size: 28rpx;
  color: var(--text);
}
.ph {
  color: var(--text-3);
}

.err {
  margin-bottom: 18rpx;
  padding: 16rpx 18rpx;
  background: rgba(176, 43, 37, 0.06);
  border: var(--stroke) solid var(--brand-border);
  border-radius: var(--radius);
  font-size: 24rpx;
  color: var(--brand-on-soft);
}
.err-hint {
  display: block;
  margin-top: 6rpx;
  color: var(--text-2);
}

/* 视觉属性（含 .btn::after 的默认灰边）统一在 app.wxss，这里只留本页间距 */
.btn {
  margin-top: 8rpx;
}


.tip {
  margin-top: 24rpx;
  padding: 0 4rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-3);
}
