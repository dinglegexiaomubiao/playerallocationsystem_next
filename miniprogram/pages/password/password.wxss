@import "../../styles/form.wxss";

.card {
  padding: 20rpx 24rpx 8rpx;
}
.err {
  margin: 4rpx 0 16rpx;
  padding: 12rpx 16rpx;
  font-size: 23rpx;
  color: var(--brand);
  background: rgba(176, 43, 37, 0.06);
  border-radius: var(--radius);
}
.tip {
  margin: 18rpx 6rpx 0;
  font-size: 21rpx;
  color: var(--text-3);
}
.btn {
  margin-top: 32rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 29rpx;
  color: #ffffff;
  background: var(--brand);
  border-radius: var(--radius);
}
.btn::after {
  border: 0;
}
.block {
  width: 100%;
}
