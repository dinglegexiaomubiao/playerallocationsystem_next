<view class="page-wrap">
  <view class="surface card">
    <view class="field">
      <view class="label">原密码</view>
      <input
        class="input"
        password
        value="{{oldPassword}}"
        data-key="oldPassword"
        bindinput="onInput"
        placeholder="当前在用的密码"
      />
      <view class="hint">拿到过临时密码的，这里就填那个临时密码</view>
    </view>

    <view class="field">
      <view class="label">新密码</view>
      <input
        class="input"
        password
        value="{{newPassword}}"
        data-key="newPassword"
        bindinput="onInput"
        placeholder="至少 6 位，最多 64 个字符"
      />
    </view>

    <view class="field">
      <view class="label">再输一次新密码</view>
      <input
        class="input"
        password
        value="{{confirm}}"
        data-key="confirm"
        bindinput="onInput"
        placeholder="两次要一致"
      />
    </view>

    <view wx:if="{{error}}" class="err">{{error}}</view>
  </view>

  <view class="tip">改完不用重新登录，但下次登录要用新密码。</view>

  <button class="btn block" bindtap="onSubmit" disabled="{{busy}}">
    {{busy ? '提交中…' : '确认修改'}}
  </button>
</view>
