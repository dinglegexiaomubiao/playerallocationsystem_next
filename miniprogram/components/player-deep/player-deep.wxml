<!-- 近期战绩 + 战绩解读。样式自带一套（组件样式隔离，页面/全局 class 进不来）。 -->
<view class="pd">
  <!-- 近期战绩：只吃 /api/player-matches（最多 200 场），口径与网页「最近比赛」一致 -->
  <view class="block">
    <view class="sec-title">近期战绩<text class="sec-note">OpenDota</text></view>

    <view wx:if="{{!hasAcc}}" class="surface empty-tip">
      没填 SteamID，拉不到战绩，也就没法读取解读。
    </view>

    <view wx:elif="{{stats.status === 'idle'}}" class="surface act-row">
      <text class="act-hint">数据从 OpenDota 实时拉，冷启动要几秒</text>
      <text class="act-btn" bindtap="onTapStats">拉取战绩</text>
    </view>

    <view wx:elif="{{stats.status === 'loading'}}" class="surface act-row">
      <text class="act-hint">正在拉取战绩…</text>
    </view>

    <view wx:elif="{{stats.status === 'error'}}" class="surface act-row">
      <text class="act-hint is-error">{{stats.error}}</text>
      <text class="act-btn" bindtap="onTapStats">重试</text>
    </view>

    <view wx:elif="{{stats.status === 'empty'}}" class="surface empty-tip">
      OpenDota 上没有这个账号的对局记录。常见原因：账号内未开启「公开比赛数据」，或 OpenDota 还没抓取过这个账号。
    </view>

    <view wx:else class="surface stats">
      <view class="cell">
        <text class="cell-num">{{stats.data.winRate}}%</text>
        <text class="cell-label">近 {{stats.data.total}} 场胜率</text>
      </view>
      <view class="cell">
        <text class="cell-num">{{stats.data.wins}} / {{stats.data.losses}}</text>
        <text class="cell-label">胜 / 负</text>
      </view>
      <view class="cell">
        <text class="cell-num">{{stats.data.kda}}</text>
        <text class="cell-label">场均 KDA</text>
      </view>
      <view class="cell">
        <text class="cell-num">{{stats.data.durationText}}</text>
        <text class="cell-label">平均时长</text>
      </view>

      <view class="stats-meta">
        <text wx:if="{{stats.data.accountLabel}}" class="stats-meta-i">{{stats.data.accountLabel}}</text>
        <text wx:if="{{stats.data.lifetimeText}}" class="stats-meta-i">生涯 {{stats.data.lifetimeText}}</text>
      </view>

      <!-- GPM / 伤害只有近 20 场这个窗口有，单独一行标清口径，不和 200 场的胜率并排看 -->
      <view wx:if="{{stats.data.gpm || stats.data.dmg}}" class="stats-window">
        <text class="stats-window-t">近 {{stats.data.gpmTotal}} 场</text>
        <text wx:if="{{stats.data.gpm}}" class="stats-window-i">GPM {{stats.data.gpm}}</text>
        <text wx:if="{{stats.data.dmg}}" class="stats-window-i">场均伤害 {{stats.data.dmg}}</text>
      </view>

      <view class="stats-best">
        <text class="stats-best-t">近 20 场最高</text>
        <text class="stats-best-i">击杀 {{stats.data.bestKills}}</text>
        <text class="stats-best-i">助攻 {{stats.data.bestAssists}}</text>
        <text class="stats-best-i">KDA {{stats.data.bestKda}}</text>
      </view>

      <view wx:if="{{stats.data.modes.length}}" class="stats-modes">
        <text wx:for="{{stats.data.modes}}" wx:key="label" class="stats-mode">{{item.label}} {{item.total}} 场 · {{item.pct}}%</text>
      </view>

      <!-- 常用项（整份样本聚合，不是最近 20 场） -->
      <view wx:if="{{stats.data.heroes.length}}" class="stats-heroes">
        <text wx:for="{{stats.data.heroes}}" wx:key="name" class="stats-hero">{{item.name}} {{item.matches}} 场 · {{item.winRate}}%</text>
      </view>

      <!-- 近 20 场色块：与「近 20 场最高」同一个窗口，一眼看手感 -->
      <view wx:if="{{stats.data.tiles.length}}" class="tiles">
        <view wx:for="{{stats.data.tiles}}" wx:key="key" class="tile {{item.isWin ? 'is-win' : 'is-lose'}}">
          <text class="tile-hero">{{item.hero}}</text>
          <text class="tile-res">{{item.isWin ? '胜' : '负'}} · {{item.kda}}</text>
        </view>
      </view>

      <!-- 逐场明细：网页端有的字段这里一个不少（结果/英雄/KDA/模式·时长/版本/段位/时间） -->
      <view wx:if="{{stats.data.list.length}}" class="mlist">
        <view wx:for="{{stats.data.list}}" wx:key="key" class="mrow">
          <view class="mrow-head">
            <text class="mrow-res {{item.isWin ? 'is-win' : 'is-lose'}}">{{item.isWin ? '胜利' : '失败'}}</text>
            <text class="mrow-hero">{{item.hero}}</text>
            <text class="mrow-kda">{{item.kdaText}}</text>
          </view>
          <view class="mrow-sub">
            <text class="mrow-tag">{{item.mode}}</text>
            <text class="mrow-tag">{{item.durText}}</text>
            <text wx:if="{{item.patch}}" class="mrow-tag">{{item.patch}}</text>
            <text wx:if="{{item.rank}}" class="mrow-tag">{{item.rank}}</text>
            <text class="mrow-ago">{{item.ago}}</text>
          </view>
        </view>
        <view wx:if="{{stats.data.listMore}}" class="mrow-more" bindtap="onTapMoreMatches">
          展开更多（已显示 {{stats.data.listShown}} / {{stats.data.total}} 场）
        </view>
      </view>
    </view>
  </view>

  <!-- 战绩解读：内容由服务器调大模型产出，小程序只拉取并展示（需登录） -->
  <view class="block">
    <view class="sec-title">战绩解读</view>

    <view wx:if="{{insight.status === 'idle'}}" class="surface act-row">
      <text class="act-hint">{{insight.idleHint}}</text>
      <text class="act-btn" bindtap="onTapInsight">{{insight.idleBtn}}</text>
    </view>

    <view wx:elif="{{insight.status === 'running'}}" class="surface ai-loading">
      <view class="spinner"></view>
      <view class="ai-loading-body">
        <text class="ai-loading-title">正在读取解读…</text>
        <text class="ai-loading-hint">约 3~10 秒，请稍候</text>
      </view>
    </view>

    <view wx:elif="{{insight.status === 'error'}}" class="surface empty-tip">
      {{insight.error}}
      <text class="ai-rerun" bindtap="onTapInsight">重试</text>
    </view>

    <view wx:elif="{{insight.status === 'empty'}}" class="surface empty-tip">
      {{insight.emptyText}}
    </view>

    <view wx:else class="surface ai-body">
      <view wx:for="{{insight.lines}}" wx:key="*this" class="ai-para">{{item}}</view>
      <view class="ai-foot">
        <text class="ai-foot-hint">从服务器读取，仅供参考</text>
        <text class="ai-rerun" bindtap="onTapInsight">重新读取</text>
      </view>
    </view>
  </view>
</view>
