/* 组件样式隔离：页面 wxss 与 app.wxss 的 class 进不来，这里自带全套。
   色值只用 app.wxss 里定义在 page 上的设计令牌（--brand / --ok / --danger ...），
   自定义属性会继承，别写不存在的 --xxx 否则静默回退成白底。 */
.pd {
  display: block;
}

.surface {
  background: var(--bg-card);
  border: var(--stroke) solid var(--border);
  border-radius: var(--radius);
}

.block {
  margin-top: 28rpx;
}
.sec-title {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-3);
  letter-spacing: 1rpx;
}
.sec-note {
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-3);
  letter-spacing: 0;
}

/* ---------------- 顶部四个数字 ---------------- */
.stats {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding: 22rpx 0;
}
.cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cell-num {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}
.cell-label {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.act-row {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-top: 16rpx;
}
.act-hint {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--text-3);
}
.act-hint.is-error {
  color: var(--brand);
}
.act-btn {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: var(--brand);
  border-radius: var(--radius-pill);
}

.empty-tip {
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--text-3);
}

/* 口径备注：场次 / 生涯，一行放不下就换行，不与上面的数字抢注意力 */
.stats-meta {
  flex: 0 0 100%;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
  padding: 16rpx 24rpx 0;
  border-top: var(--stroke) solid var(--border);
}
.stats-meta-i {
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--text-3);
  margin-right: 18rpx;
}
.stats-meta-i:last-child {
  margin-right: 0;
}

/* GPM / 场均伤害：唯一的近 20 场窗口，必须自带口径标签 */
.stats-window {
  flex: 0 0 100%;
  box-sizing: border-box;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-top: 10rpx;
  padding: 0 24rpx;
}
.stats-window-t {
  font-size: 20rpx;
  color: var(--text-3);
  background: var(--bg-subtle);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-xs);
  margin-right: 14rpx;
}
.stats-window-i {
  font-size: 21rpx;
  color: var(--text-2);
  margin-right: 18rpx;
}

/* 近 20 场最高：网页端是工具栏右侧一句，这里拆成三个并列小项 */
.stats-best {
  flex: 0 0 100%;
  box-sizing: border-box;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-top: 12rpx;
  padding: 0 24rpx;
}
.stats-best-t {
  font-size: 20rpx;
  color: var(--text-3);
  background: var(--bg-subtle);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-xs);
  margin-right: 14rpx;
}
.stats-best-i {
  font-size: 21rpx;
  color: var(--text-2);
  margin-right: 18rpx;
}

/* 模式分布：网页端那排可点筛选 tab 的静态版 */
.stats-modes {
  flex: 0 0 100%;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
  padding: 0 24rpx;
}
.stats-mode {
  font-size: 21rpx;
  color: var(--text-2);
  border: var(--stroke) solid var(--border);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  margin: 0 10rpx 10rpx 0;
}

.stats-heroes {
  flex: 0 0 100%;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding: 0 24rpx;
}
.stats-hero {
  font-size: 21rpx;
  color: var(--text-2);
  background: var(--bg-subtle);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  margin: 0 10rpx 10rpx 0;
}

/* 近 20 场色块：胜绿败红，左侧色条 + 英雄名，一行 4 个
   ⚠ 小程序盒模型默认是 content-box：width 里不含 padding 和 border，
   不写 border-box 的话每格实际宽 25%+，4 个凑不满一行（只出 3 列）并且整体右溢。 */
.tiles {
  flex: 0 0 100%;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding: 16rpx 24rpx 0;
  border-top: var(--stroke) solid var(--border);
}
.tile {
  box-sizing: border-box;
  width: calc(25% - 12rpx);
  margin: 0 16rpx 12rpx 0;
  padding: 8rpx;
  border-radius: var(--radius-xs);
  border: var(--stroke) solid var(--border);
  border-left-width: 6rpx;
  background: var(--bg-card);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  overflow: hidden;
}
.tile:nth-child(4n) {
  margin-right: 0;
}
.tile.is-win {
  border-left-color: var(--ok);
  background: var(--ok-soft);
}
.tile.is-lose {
  border-left-color: var(--danger);
  background: var(--danger-soft);
}
.tile-hero {
  width: 100%;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tile-res {
  font-size: 19rpx;
  color: var(--text-3);
  margin-top: 2rpx;
}
.tile.is-win .tile-res {
  color: var(--ok);
}
.tile.is-lose .tile-res {
  color: var(--danger);
}

/* 逐场明细 */
.mlist {
  flex: 0 0 100%;
  box-sizing: border-box;
  margin-top: 6rpx;
  padding: 8rpx 24rpx 0;
}
.mrow {
  padding: 16rpx 0;
  border-bottom: var(--stroke) solid var(--border);
}
.mrow:last-child {
  border-bottom: 0;
}
.mrow-head {
  display: flex;
  align-items: baseline;
}
.mrow-res {
  flex: 0 0 auto;
  width: 64rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.mrow-res.is-win {
  color: var(--ok);
}
.mrow-res.is-lose {
  color: var(--danger);
}
.mrow-hero {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.mrow-kda {
  flex: 0 0 auto;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}
.mrow-sub {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 6rpx;
  padding-left: 64rpx;
}
.mrow-tag {
  font-size: 19rpx;
  color: var(--text-3);
  background: var(--bg-subtle);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-xs);
  margin: 0 10rpx 4rpx 0;
}
.mrow-ago {
  font-size: 19rpx;
  color: var(--text-3);
  margin-left: auto;
}
.mrow-more {
  margin-top: 16rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: var(--brand);
  background: var(--bg-subtle);
  border-radius: var(--radius-xs);
}

/* ---------------- 战绩解读 ---------------- */
.ai-loading {
  display: flex;
  align-items: center;
  padding: 30rpx 24rpx;
  margin-top: 16rpx;
}
.ai-loading-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.ai-loading-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}
.ai-loading-hint {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 转圈：纯 CSS，别为这个引图片 */
.spinner {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: ai-spin 0.9s linear infinite;
}
@keyframes ai-spin {
  to {
    transform: rotate(360deg);
  }
}

.ai-body {
  padding: 24rpx;
  margin-top: 16rpx;
}

/* 解读文本：逐行渲染（<text> 不保证保留换行，按行拆开最稳） */
.ai-para {
  font-size: 25rpx;
  line-height: 1.8;
  color: var(--text-2);
  word-break: break-word;
  margin-bottom: 10rpx;
}
.ai-para:last-child {
  margin-bottom: 0;
}

.ai-foot {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: var(--stroke) dashed var(--border);
}
.ai-foot-hint {
  flex: 1;
  font-size: 21rpx;
  color: var(--text-3);
}
.ai-rerun {
  font-size: 22rpx;
  color: var(--brand);
  padding: 4rpx 14rpx;
  border: var(--stroke) solid var(--brand-border);
  border-radius: var(--radius-sm);
}
