# 环境变量文件
.env
.env.local
.env.development
.env.production

# Next.js 相关
.next/
out/
!.next/static/
.next/static/chunks/
.next/static/css/
.next/static/media/
.next/static/development/
.next/static/runtime/
.next/cache/

# 依赖文件夹
node_modules/

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 临时文件
.tmp
.temp

# 操作系统文件
.DS_Store
Thumbs.db

# IDE文件
.vscode/
.idea/
*.swp
*.swo

# 构建输出
dist/
build/

# 数据文件（如果使用本地文件存储数据）
data/*.json
!data/README.md

# 根目录的本地导入 / 测试数据（含群友真实 SteamID 等信息，禁止进入公开仓库）
测试的数据.*

# 编辑器和操作系统生成的文件
*~
\#*\#
/.history
/.vscode
/.idea

# TypeScript 编译输出
*.tsbuildinfo

# Claude Code 本地配置
.claude/

# WorkBuddy 本地数据（记忆等）
.workbuddy/
# 无头浏览器临时 profile（验证脚本用，跑完即删，禁止入库）
_*_profile/

# 图片缓存（英雄头像 / Steam 头像，首次访问自动回源落下，不入库）
.cache/

# Neon 弃用前的数据归档（含用户反馈/IP，不进仓库）
backups/
# 旧的 env 备份（含连接串与密钥）
.env.local.bak*

# 本地截图产物（scripts/check-diag.cjs 等生成）
shots/
