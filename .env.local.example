# 本地开发 / 维护脚本的环境变量模板
#
# 用法：
#   1. 复制本文件为 .env.local（该文件已被 .gitignore 忽略，不会入库）
#   2. 填入真实值。Next.js 会自动加载 .env.local；
#      用 `node import-players.js` 这类独立脚本也会经 scripts/env.js 读取。
#
# 注意：连接串里含密码，只能放在 .env.local 或部署平台的环境变量里。
# 本项目曾因把连接串硬编码进 lib/db.js 等 6 个文件、并推到公开仓库，
# 导致数据库密码进入 git 历史 —— 需要轮换后才安全。不要把明文写回代码。

# ===== 必填：数据库 =====
# Neon 控制台 → Connection Details → 选 Pooled connection（主机名带 -pooler）
# 库所在区域是 ap-southeast-1（新加坡），Vercel 函数区域应设为 sin1 以对齐，见 vercel.json
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ===== 必填：会话签名密钥 =====
# 未设置时会退化为用 DATABASE_URL 派生，更换数据库会导致所有人掉登录。
# 生产环境请固定一个随机值，例：openssl rand -hex 32
AUTH_SECRET=

# ===== 必填：管理员账号 =====
# 逗号分隔，大小写不敏感。未配置时默认只有 dom。
ADMIN_NAMES=dom

# ===== 选填：AI 分析 =====
# 不配则 /api/ai-analysis 返回 500，其余功能不受影响
ANTHROPIC_API_KEY=
# 走兼容 Anthropic 协议的中转时填写；不填则直连 api.anthropic.com
ANTHROPIC_BASE_URL=

# ===== 选填：通知（用户反馈 / 新用户注册） =====
# 不配则只是不发通知，工单仍正常入库、注册也照常成功。
# 配了之后有两类事件会推给你：①用户反馈工单 ②有人注册了新账号。
# 最省事的配法是只配 SUPPORT_WEBHOOK_URL（企业微信/钉钉群机器人），不用碰邮箱。
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=465
SUPPORT_SMTP_USER=
SUPPORT_SMTP_PASS=
SUPPORT_MAIL_FROM=
SUPPORT_MAIL_TO=
SUPPORT_MAIL_ERRORS=true
# 也可以用 webhook 代替 SMTP（二者选一）
SUPPORT_WEBHOOK_URL=
