# 统一行尾，避免 Windows 上提交的 shell 脚本在 Linux 上因为 CRLF 报
# "bad interpreter: /bin/bash^M"

* text=auto

# Shell 脚本必须 LF，否则服务器上执行会失败
*.sh text eol=lf

# 只在 Windows 上用的脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制，别做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.xlsx binary
*.woff binary
*.woff2 binary
